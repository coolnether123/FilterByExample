<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>FilterByExample.RimWorldContracts.Tests</AssemblyName>
    <RootNamespace>FilterByExample.RimWorldContracts.Tests</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="RimWorldContractsProgram.cs" />
    <Compile Include="..\Source\Domain\ExampleFilterOperation.cs"
             Link="ExampleFilterOperation.cs" />
    <Compile Include="..\Source\Domain\IExampleFilterTarget.cs"
             Link="IExampleFilterTarget.cs" />
    <Compile Include="..\Source\Domain\FilterMutationResult.cs"
             Link="FilterMutationResult.cs" />
    <Compile Include="..\Source\Domain\FilterByExampleService.cs"
             Link="FilterByExampleService.cs" />
    <Compile Include="..\Source\Domain\ReferenceIdentityComparer.cs"
             Link="ReferenceIdentityComparer.cs" />
    <Compile Include="..\Source\Runtime\StorageFilterTarget.cs"
             Link="StorageFilterTarget.cs" />
  </ItemGroup>
  <Target Name="RequireResolvedRimWorld" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(RimWorldManagedDir)' == '' or !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
      Text="RimWorldManagedDir must resolve through RimWorld-Tooling." />
  </Target>
</Project>
